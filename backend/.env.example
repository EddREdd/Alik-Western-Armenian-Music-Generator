# Copy to backend/.env for local Spring Boot runs.
# SECURITY: use placeholders only. Never commit real API keys or passwords.
#
# External BeeSync MinIO (S3 API :9000). MEDIA_STORAGE_SPACES_* can mirror MINIO_* via application.yml.

APP_NAME=musicgen-backend

SPRING_DATA_MONGODB_URI=mongodb://replace-user:replace-pass@localhost:27017/alike_db?authSource=admin
SPRING_DATA_MONGODB_DATABASE=alike_db

PROVIDER_BASE_URL=https://api.sunoapi.org
PROVIDER_API_KEY=replace-with-your-suno-api-key
PROVIDER_CALLBACK_BASE_URL=http://localhost:8080

FEATURE_PROVIDER_SUBMISSION_ENABLED=false
FEATURE_CALLBACK_PROCESSING_ENABLED=true
FEATURE_ADMIN_ENDPOINTS_ENABLED=true

POLLING_ENABLED=true
POLLING_INTERVAL_MS=60000
POLLING_BATCH_SIZE=10
POLLING_BASE_DELAY_SECONDS=60
POLLING_MAX_DELAY_SECONDS=900

SCHEDULE_EXECUTION_ENABLED=true
SCHEDULE_EXECUTION_INTERVAL_MS=60000
SCHEDULE_EXECUTION_BATCH_SIZE=10

OPS_STUCK_THRESHOLD_MINUTES=30
OPS_RAW_PAYLOAD_PREVIEW_LENGTH=200
LOG_LEVEL_ROOT=INFO

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=http://*.traefik.me,https://*.traefik.me

MEDIA_STORAGE_TYPE=spaces

MINIO_ENDPOINT=http://storage.beesync.co:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=alik
MINIO_ROOT_USER=beesyncadmin
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_PUBLIC_BASE_URL=http://storage.beesync.co:9000/alik

MEDIA_STORAGE_SPACES_ENDPOINT=http://storage.beesync.co:9000
MEDIA_STORAGE_SPACES_REGION=us-east-1
MEDIA_STORAGE_SPACES_BUCKET=alik
MEDIA_STORAGE_SPACES_ACCESS_KEY=beesyncadmin
MEDIA_STORAGE_SPACES_SECRET_KEY=replace-with-minio-password
MEDIA_STORAGE_SPACES_PUBLIC_BASE_URL=http://storage.beesync.co:9000/alik

# Comma-separated hosts allowed for GET /api/v1/media/proxy
MEDIA_PROXY_ALLOWED_HOSTS=storage.beesync.co,musicfile.removeai.ai,tempfile.aiquickdraw.com

# Optional: HEAD probe at startup to warn if MinIO objects are not anonymously readable
# MEDIA_STORAGE_PUBLIC_PROBE_URL=http://storage.beesync.co:9000/alik/audio/sample.mp3

AUTH_ADMIN_EMAILS=edward@alikfoundation.com
AUTH_DEFAULT_INVITE_CODE=ALIK-INVITE
AUTH_EXPOSE_OTP_IN_RESPONSE=false

# SendGrid (invite emails, password reset). Use a verified sender in SendGrid.
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
SENDGRID_FROM_ADDRESS=edward@alikfoundation.com
SENDGRID_FROM_NAME=Alik Music

EMAIL_PUBLIC_APP_URL=http://localhost:3000
EMAIL_SUPPORT_ADDRESS=edward@alikfoundation.com
