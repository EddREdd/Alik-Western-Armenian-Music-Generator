# Copy to .env for Docker Compose / Dokploy deployments.
# SECURITY: never commit real secrets. Rotate any credentials that were ever committed to git.
#
# MinIO container credentials (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD):
#   used only by the minio service.
# Backend S3 uploads use MEDIA_STORAGE_SPACES_ACCESS_KEY / MEDIA_STORAGE_SPACES_SECRET_KEY
#   set to the same values as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# S3 API port is :9000 (not console :9001).

# --- Production / Dokploy / Traefik (recommended) ---
NEXT_PUBLIC_BACKEND_URL=
INTERNAL_BACKEND_URL=http://backend:8080
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=http://*.traefik.me,https://*.traefik.me

SERVER_PORT=8080
APP_NAME=musicgen-backend
SPRING_DATA_MONGODB_URI=mongodb://replace-user:replace-pass@replace-host:27017/alike_db?authSource=admin
SPRING_DATA_MONGODB_DATABASE=alike_db
LOG_LEVEL_ROOT=INFO
FEATURE_PROVIDER_SUBMISSION_ENABLED=true
FEATURE_CALLBACK_PROCESSING_ENABLED=true
FEATURE_ADMIN_ENDPOINTS_ENABLED=true

PROVIDER_BASE_URL=https://api.sunoapi.org
PROVIDER_API_KEY=replace-with-your-suno-api-key
PROVIDER_CALLBACK_BASE_URL=https://your-frontend-or-backend-public-url

# Backend uploads (internal Docker network — use minio service hostname)
MEDIA_STORAGE_TYPE=spaces
MEDIA_STORAGE_SPACES_ENDPOINT=http://minio:9000
MEDIA_STORAGE_SPACES_REGION=us-east-1
MEDIA_STORAGE_SPACES_BUCKET=alik
MEDIA_STORAGE_SPACES_ACCESS_KEY=minioadmin
MEDIA_STORAGE_SPACES_SECRET_KEY=replace-with-minio-password
MEDIA_STORAGE_SPACES_PUBLIC_BASE_URL=http://alik-minio-5247b3-95-140-192-45.traefik.me:9000/alik

# MinIO container only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_BROWSER_REDIRECT_URL=http://alik-minio-5247b3-95-140-192-45.traefik.me:9001

AUTH_ADMIN_EMAILS=admin@yourdomain.com
AUTH_DEFAULT_INVITE_CODE=BALIANS-INVITE
AUTH_EXPOSE_OTP_IN_RESPONSE=false
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
SENDGRID_FROM_ADDRESS=notifications@yourdomain.com
SENDGRID_FROM_NAME=Alik Music

NEXT_PUBLIC_DEFAULT_PROJECT_ID=project-1
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
